# YouTube Data API v3
# Obtener en: https://console.cloud.google.com > YouTube Data API v3
YOUTUBE_API_KEY=tu_youtube_api_key_aqui

# Google Gemini API
# Obtener en: https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Canales a monitorear (handles de YouTube, separados por coma)
YOUTUBE_CHANNELS=JoseLuisCavatv,HOPLAFinance

# Vercel KV (Redis) - para producción
# Configurar en: Vercel Dashboard > Storage > KV
KV_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Tipo de almacenamiento: 'kv' (Vercel KV) o 'local' (JSON local, solo desarrollo)
STORAGE_TYPE=local

# Secret para proteger el endpoint del cron (inventa cualquier string)
CRON_SECRET=mi_cron_secret_aqui

# URL base de la app
NEXT_PUBLIC_BASE_URL=http://localhost:3000
